{
  "name": "margen",
  "version": "0.1.0",
  "private": true,
  "description": "EPUB reading workspace with contextual notes, flashcards, browser speech and portable data folders.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/David55512345/margen.git" },
  "bugs": { "url": "https://github.com/David55512345/margen/issues" },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1",
    "build": "vinext build",
    "start": "vinext start --hostname 127.0.0.1",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/rendered-html.test.mjs tests/vault.test.mjs tests/vault-api.test.mjs tests/annotation-conversion.test.mjs tests/shortcut-bindings.test.mjs tests/reader-viewport.test.mjs tests/local-access.test.mjs",
    "db:local": "wrangler d1 migrations apply site-creator-d1 --local --config tests/wrangler.local.json --persist-to .wrangler/state",
    "demo:epub": "node tests/create-reader-fixture.mjs",
    "check:public": "node scripts/check-public-source.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  }
}
